; Export definition for the OpenAnsel d3d9.dll proxy.
; Direct3DCreate9 and Direct3DCreate9Ex are implemented in d3d9_proxy.cpp.
; All other exports are forwarded through function stubs in d3d9_proxy.cpp.
LIBRARY d3d9
EXPORTS
    Direct3DCreate9
    Direct3DCreate9Ex
    Direct3DShaderValidatorCreate9
    D3DPERF_BeginEvent
    D3DPERF_EndEvent
    D3DPERF_GetStatus
    D3DPERF_QueryRepeatFrame
    D3DPERF_SetMarker
    D3DPERF_SetOptions
    D3DPERF_SetRegion
    DebugSetLevel
    DebugSetMute
